# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/websocket_chat
REDIS_URL=redis://127.0.0.1:6379/0
MAX_ROOMS_PER_USER=20

# Обязательно сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Список origins — JSON-массив строк
CORS_ORIGINS=["http://localhost:5173"]